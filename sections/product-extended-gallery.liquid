{% comment %}
  Product Extended Gallery Section
  Displays the remaining product images (from the 5th onward) as a 4-column slider.
  Matches the top gallery styling and provides smooth horizontal sliding.
{% endcomment %}

{%- if product.media.size > 4 -%}
  <div class="product-extended-gallery-wrapper" id="ProductExtendedGallery-{{ section.id }}" data-section-id="{{ section.id }}">
    <div class="product-extended-gallery">
      <div class="product-extended-gallery__slider-container">
        <button
          type="button"
          class="product-extended-gallery__arrow product-extended-gallery__arrow--prev"
          aria-label="{{ 'actions.previous' | t | default: 'Previous' }}"
          title="Previous"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="product-extended-gallery__grid" role="region" aria-label="Product extended gallery slider" tabindex="0">
          {%- for media in product.media offset: 4 -%}
            {%- assign original_media_index = forloop.index0 | plus: 4 -%}
            <div 
              class="product-extended-gallery__item" 
              data-media-id="{{ media.id }}"
              data-media-index="{{ original_media_index }}"
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{ media | image_url: width: 1400 | image_tag: 
                    loading: 'lazy', 
                    class: 'product-extended-gallery__image',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 25vw, 100vw' 
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: true, class: 'product-extended-gallery__video' }}
                {%- else -%}
                  {{ media | media_tag: class: 'product-extended-gallery__media' }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="product-extended-gallery__arrow product-extended-gallery__arrow--next"
          aria-label="{{ 'actions.next' | t | default: 'Next' }}"
          title="Next"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <div class="product-extended-gallery__dots" aria-hidden="true"></div>
    </div>
  </div>

  <script>
    (function() {
      function initExtendedGallery() {
        const wrapper = document.querySelector('.product-extended-gallery-wrapper');
        if (!wrapper) return;

        // 1. Move wrapper below product-information section if needed
        const productInfo = document.querySelector('.product-information');
        const productDetails = document.querySelector('.product-details');
        const mainSection = productInfo || (productDetails ? productDetails.closest('.section') || productDetails.parentNode : null);
        if (mainSection && mainSection.parentNode) {
          if (wrapper.parentNode !== mainSection.parentNode || wrapper.previousElementSibling !== mainSection) {
            mainSection.parentNode.insertBefore(wrapper, mainSection.nextElementSibling);
          }
        }

        const grid = wrapper.querySelector('.product-extended-gallery__grid');
        const prevBtn = wrapper.querySelector('.product-extended-gallery__arrow--prev');
        const nextBtn = wrapper.querySelector('.product-extended-gallery__arrow--next');
        const dotsContainer = wrapper.querySelector('.product-extended-gallery__dots');

        if (!grid || !prevBtn || !nextBtn) return;

        function getVisibleItems() {
          return Array.from(grid.querySelectorAll('.product-extended-gallery__item')).filter((item) => {
            return !item.hasAttribute('hidden') && window.getComputedStyle(item).display !== 'none';
          });
        }

        function updateControls() {
          const visibleItems = getVisibleItems();
          if (visibleItems.length === 0) {
            wrapper.style.display = 'none';
            return;
          }

          const maxScrollLeft = grid.scrollWidth - grid.clientWidth;
          const isScrollable = maxScrollLeft > 8;

          if (!isScrollable) {
            prevBtn.style.opacity = '0';
            prevBtn.style.pointerEvents = 'none';
            nextBtn.style.opacity = '0';
            nextBtn.style.pointerEvents = 'none';
            if (dotsContainer) dotsContainer.style.display = 'none';
            return;
          }

          // Update arrow visibility
          if (grid.scrollLeft <= 10) {
            prevBtn.style.opacity = '0';
            prevBtn.style.pointerEvents = 'none';
          } else {
            prevBtn.style.opacity = '1';
            prevBtn.style.pointerEvents = 'auto';
          }

          if (grid.scrollLeft >= maxScrollLeft - 10) {
            nextBtn.style.opacity = '0';
            nextBtn.style.pointerEvents = 'none';
          } else {
            nextBtn.style.opacity = '1';
            nextBtn.style.pointerEvents = 'auto';
          }

          // Update dots
          if (dotsContainer) {
            const dots = dotsContainer.querySelectorAll('.product-extended-gallery__dot');
            if (dots.length > 0) {
              const scrollProgress = grid.scrollLeft / maxScrollLeft;
              const activeIndex = Math.min(
                dots.length - 1,
                Math.max(0, Math.round(scrollProgress * (dots.length - 1)))
              );
              dots.forEach((dot, idx) => {
                if (idx === activeIndex) {
                  dot.classList.add('is-active');
                } else {
                  dot.classList.remove('is-active');
                }
              });
            }
          }
        }

        function setupDots() {
          if (!dotsContainer) return;
          dotsContainer.innerHTML = '';

          const visibleItems = getVisibleItems();
          if (visibleItems.length <= 4 && window.innerWidth >= 750) {
            dotsContainer.style.display = 'none';
            return;
          }

          const itemsPerView = window.innerWidth >= 750 ? 4 : 1;
          const totalPages = Math.ceil(visibleItems.length / itemsPerView);

          if (totalPages <= 1) {
            dotsContainer.style.display = 'none';
            return;
          }

          dotsContainer.style.display = 'flex';
          for (let i = 0; i < totalPages; i++) {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'product-extended-gallery__dot' + (i === 0 ? ' is-active' : '');
            dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
            dot.addEventListener('click', () => {
              const targetItemIndex = i * itemsPerView;
              const targetItem = visibleItems[Math.min(targetItemIndex, visibleItems.length - 1)];
              if (targetItem) {
                grid.scrollTo({
                  left: targetItem.offsetLeft,
                  behavior: 'smooth'
                });
              }
            });
            dotsContainer.appendChild(dot);
          }
        }

        function scrollByPage(direction) {
          const visibleItems = getVisibleItems();
          if (visibleItems.length === 0) return;

          const scrollDistance = grid.clientWidth;
          grid.scrollBy({
            left: direction * scrollDistance,
            behavior: 'smooth'
          });
        }

        // Arrow click handlers
        prevBtn.onclick = (e) => {
          e.preventDefault();
          scrollByPage(-1);
        };
        nextBtn.onclick = (e) => {
          e.preventDefault();
          scrollByPage(1);
        };

        // Scroll listener (throttled)
        let ticking = false;
        grid.onscroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateControls();
              ticking = false;
            });
            ticking = true;
          }
        };

        // Click on extended gallery image to open main zoom modal if present
        grid.querySelectorAll('.product-extended-gallery__item').forEach((item) => {
          item.onclick = (e) => {
            const mediaGallery = document.querySelector('media-gallery');
            const mediaId = item.getAttribute('data-media-id');
            if (mediaGallery && mediaId) {
              const zoomBtn = mediaGallery.querySelector(`li[data-media-id="${mediaId}"] .product-media-container__zoom-button`);
              if (zoomBtn) {
                zoomBtn.click();
              }
            }
          };
        });

        // MutationObserver to detect variant changes from media-gallery.js
        if (!grid._observerAttached) {
          const observer = new MutationObserver(() => {
            setupDots();
            updateControls();
          });
          observer.observe(grid, { childList: true, attributes: true, attributeFilter: ['style', 'hidden'] });
          grid._observerAttached = true;
        }

        // Window resize handler
        window.addEventListener('resize', () => {
          setupDots();
          updateControls();
        });

        // Initial setup
        setupDots();
        updateControls();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initExtendedGallery);
      } else {
        initExtendedGallery();
      }
      document.addEventListener('shopify:section:load', initExtendedGallery);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product extended gallery",
  "tag": "section",
  "class": "section product-extended-gallery-section",
  "settings": [],
  "presets": [
    {
      "name": "Product extended gallery"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .product-extended-gallery-wrapper {
    width: 100%;
    margin: 40px auto;
    padding: 0;
    box-sizing: border-box;
    position: relative;
  }

  .product-extended-gallery {
    padding-top: 0;
    width: 100%;
    position: relative;
  }

  .product-extended-gallery__slider-container {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .product-extended-gallery__grid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE & Edge */
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
  }

  .product-extended-gallery__grid::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  .product-extended-gallery__item {
    position: relative;
    flex: 0 0 calc((100% - 3 * 1rem) / 4);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-background-secondary, #f9f9f9);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-sizing: border-box;
  }

  .product-extended-gallery__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover !important;
    aspect-ratio: 3 / 4 !important;
    transition: transform 0.3s ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  .product-extended-gallery__item:hover .product-extended-gallery__image {
    transform: scale(1.02);
  }

  .product-extended-gallery__video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  .product-extended-gallery__media {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  /* Navigation Arrows */
  .product-extended-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    color: #111111;
    transition: opacity 0.25s ease, transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    opacity: 1;
    padding: 0;
  }

  .product-extended-gallery__arrow--prev {
    left: 16px;
  }

  .product-extended-gallery__arrow--next {
    right: 16px;
  }

  .product-extended-gallery__arrow:hover {
    background-color: #ffffff;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
  }

  .product-extended-gallery__arrow:active {
    transform: translateY(-50%) scale(0.96);
  }

  .product-extended-gallery__arrow svg {
    display: block;
    pointer-events: none;
  }

  /* Navigation Dots */
  .product-extended-gallery__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
    width: 100%;
  }

  .product-extended-gallery__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .product-extended-gallery__dot:hover {
    background-color: rgba(0, 0, 0, 0.5);
    transform: scale(1.2);
  }

  .product-extended-gallery__dot.is-active {
    width: 24px;
    border-radius: 12px;
    background-color: #111111;
  }

  @media screen and (max-width: 749px) {
    .product-extended-gallery-wrapper {
      margin: 24px auto;
    }

    .product-extended-gallery__grid {
      gap: 0.5rem;
    }

    .product-extended-gallery__item {
      flex: 0 0 100%;
      aspect-ratio: 3 / 4;
    }

    .product-extended-gallery__arrow {
      width: 38px;
      height: 38px;
    }

    .product-extended-gallery__arrow--prev {
      left: 8px;
    }

    .product-extended-gallery__arrow--next {
      right: 8px;
    }

    .product-extended-gallery__arrow svg {
      width: 18px;
      height: 18px;
    }
  }

  /* Hide empty section after moving wrapper */
  .product-extended-gallery-section:empty,
  .product-extended-gallery-section:not(:has(.product-extended-gallery-wrapper)) {
    display: none !important;
  }
{% endstylesheet %}
