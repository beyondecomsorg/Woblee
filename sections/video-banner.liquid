{% liquid
  assign desktop_video = section.settings.desktop_video
  assign mobile_video = section.settings.mobile_video
%}

<section
  id="responsive-video-{{ section.id }}"
  class="responsive-video-section"
  style="
    --desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="responsive-video-wrapper">

    {% if section.settings.video_link != blank %}
      <a
        href="{{ section.settings.video_link }}"
        class="responsive-video-link"
        {% if section.settings.open_new_tab %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
      >
    {% endif %}

    {% comment %}
      DESKTOP VIDEO
    {% endcomment %}

    {% if desktop_video != blank %}
      <div class="responsive-video responsive-video--desktop">
        {{
          desktop_video
          | video_tag:
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: section.settings.muted,
            controls: section.settings.controls,
            playsinline: true,
            preload: 'metadata'
        }}
      </div>
    {% endif %}


    {% comment %}
      MOBILE VIDEO
    {% endcomment %}

    {% if mobile_video != blank %}
      <div class="responsive-video responsive-video--mobile">
        {{
          mobile_video
          | video_tag:
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: section.settings.muted,
            controls: section.settings.controls,
            playsinline: true,
            preload: 'metadata'
        }}
      </div>

    {% elsif desktop_video != blank %}

      {% comment %}
        If no mobile video is selected,
        use desktop video on mobile.
      {% endcomment %}

      <div class="responsive-video responsive-video--mobile">
        {{
          desktop_video
          | video_tag:
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: section.settings.muted,
            controls: section.settings.controls,
            playsinline: true,
            preload: 'metadata'
        }}
      </div>

    {% endif %}

    {% if section.settings.video_link != blank %}
      </a>
    {% endif %}

  </div>
</section>


<style>
  #responsive-video-{{ section.id }} {
    padding-top: var(--desktop-padding-top);
    padding-bottom: var(--desktop-padding-bottom);
    width: 100%;
  }

  #responsive-video-{{ section.id }} .responsive-video-wrapper {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  #responsive-video-{{ section.id }} .responsive-video-link {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  #responsive-video-{{ section.id }} .responsive-video {
    width: 100%;
    line-height: 0;
  }

  #responsive-video-{{ section.id }} .responsive-video video {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: cover;
  }

  /* Desktop */
  #responsive-video-{{ section.id }} .responsive-video--desktop {
    display: block;
  }

  #responsive-video-{{ section.id }} .responsive-video--mobile {
    display: none;
  }


  /* Mobile */
  @media screen and (max-width: 749px) {

    #responsive-video-{{ section.id }} {
      padding-top: var(--mobile-padding-top);
      padding-bottom: var(--mobile-padding-bottom);
    }

    #responsive-video-{{ section.id }} .responsive-video--desktop {
      display: none;
    }

    #responsive-video-{{ section.id }} .responsive-video--mobile {
      display: block;
    }

  }
</style>


{% schema %}
{
  "name": "Responsive Video",
  "tag": "section",
  "class": "section-responsive-video",

  "settings": [

    {
      "type": "header",
      "content": "Videos"
    },

    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop video"
    },

    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video"
    },

    {
      "type": "header",
      "content": "Link"
    },

    {
      "type": "url",
      "id": "video_link",
      "label": "Video link"
    },

    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },

    {
      "type": "header",
      "content": "Video settings"
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show controls",
      "default": false
    },

    {
      "type": "header",
      "content": "Desktop spacing"
    },

    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Mobile spacing"
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }

  ],

  "presets": [
    {
      "name": "Responsive Video"
    }
  ]
}
{% endschema %}