<script>
(function() {
  function initFaq() {
    const faqSection = document.getElementById('faq-section-{{ section.id }}');
    if (!faqSection || faqSection.dataset.faqInitialized === 'true') return;
    faqSection.dataset.faqInitialized = 'true';

    const navButtons = faqSection.querySelectorAll('.faq-nav-btn');
    const panels = faqSection.querySelectorAll('.faq-category-panel');
    const mobileTrigger = faqSection.querySelector('.faq-mobile-trigger');
    const mobileTriggerText = faqSection.querySelector('.faq-mobile-trigger-text');
    const navList = faqSection.querySelector('.faq-nav-list');

    // 1. Category Switching functionality
    function switchCategory(targetCat) {
      const activePanel = faqSection.querySelector('.faq-category-panel.is-active');
      const targetPanel = faqSection.querySelector(`#faq-panel-${targetCat}`);
      
      if (activePanel === targetPanel) return;

      if (activePanel) {
        activePanel.classList.remove('is-visible');
        setTimeout(() => {
          activePanel.style.display = 'none';
          activePanel.classList.remove('is-active');
          showTargetPanel(targetPanel);
        }, 200);
      } else {
        showTargetPanel(targetPanel);
      }
    }

    function showTargetPanel(panel) {
      if (!panel) return;
      panel.style.display = 'block';
      panel.offsetHeight; // force reflow
      panel.classList.add('is-active');
      
      // Set active accordion states based on settings
      const triggers = panel.querySelectorAll('.faq-accordion-trigger');
      triggers.forEach((trigger, index) => {
        const content = trigger.closest('.faq-accordion-item').querySelector('.faq-accordion-content');
        const shouldOpen = index === 0 && {% if section.settings.open_first %}true{% else %}false{% endif %};
        
        if (shouldOpen) {
          trigger.setAttribute('aria-expanded', 'true');
          if (content) {
            content.style.maxHeight = content.scrollHeight + 'px';
            content.setAttribute('aria-hidden', 'false');
            content.classList.add('is-open');
          }
        } else {
          trigger.setAttribute('aria-expanded', 'false');
          if (content) {
            content.style.maxHeight = '0px';
            content.setAttribute('aria-hidden', 'true');
            content.classList.remove('is-open');
          }
        }
      });

      setTimeout(() => {
        panel.classList.add('is-visible');
      }, 20);
    }

    navButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        
        const targetCat = this.getAttribute('data-target-cat');
        
        // Update active nav button states
        navButtons.forEach(btn => {
          btn.classList.remove('is-active');
          btn.setAttribute('aria-selected', 'false');
        });
        this.classList.add('is-active');
        this.setAttribute('aria-selected', 'true');

        // Update mobile trigger label
        if (mobileTriggerText) {
          mobileTriggerText.textContent = this.textContent.trim();
        }

        // Close mobile dropdown list
        if (mobileTrigger) {
          mobileTrigger.setAttribute('aria-expanded', 'false');
        }
        if (navList) {
          navList.classList.remove('is-open');
        }

        switchCategory(targetCat);
      });
    });

    // Mobile navigation trigger toggle
    if (mobileTrigger && navList) {
      mobileTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !isExpanded);
        navList.classList.toggle('is-open');
      });

      // Close mobile dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!mobileTrigger.contains(e.target) && !navList.contains(e.target)) {
          mobileTrigger.setAttribute('aria-expanded', 'false');
          navList.classList.remove('is-open');
        }
      });
    }

    // 2. Accordion expand/collapse functionality (Only 1 open at a time per category panel)
    const accordionTriggers = faqSection.querySelectorAll('.faq-accordion-trigger');

    accordionTriggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const currentItem = this.closest('.faq-accordion-item');
        const currentPanel = this.closest('.faq-category-panel');
        const currentContent = currentItem.querySelector('.faq-accordion-content');

        // Collapse all other accordion items in the active panel
        currentPanel.querySelectorAll('.faq-accordion-item').forEach(item => {
          if (item !== currentItem) {
            const otherTrigger = item.querySelector('.faq-accordion-trigger');
            const otherContent = item.querySelector('.faq-accordion-content');
            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
            if (otherContent) {
              otherContent.style.maxHeight = '0px';
              otherContent.setAttribute('aria-hidden', 'true');
              otherContent.classList.remove('is-open');
            }
          }
        });

        // Toggle state of clicked item
        if (isExpanded) {
          this.setAttribute('aria-expanded', 'false');
          if (currentContent) {
            currentContent.style.maxHeight = '0px';
            currentContent.setAttribute('aria-hidden', 'true');
            currentContent.classList.remove('is-open');
          }
        } else {
          this.setAttribute('aria-expanded', 'true');
          if (currentContent) {
            currentContent.style.maxHeight = currentContent.scrollHeight + 'px';
            currentContent.setAttribute('aria-hidden', 'false');
            currentContent.classList.add('is-open');
          }
        }
      });
    });

    // 3. Set first accordion item of the active panel open by default if setting is enabled
    {% if section.settings.open_first %}
      const activePanel = faqSection.querySelector('.faq-category-panel.is-active');
      if (activePanel) {
        const firstTrigger = activePanel.querySelector('.faq-accordion-trigger');
        if (firstTrigger) {
          const firstContent = firstTrigger.closest('.faq-accordion-item').querySelector('.faq-accordion-content');
          firstTrigger.setAttribute('aria-expanded', 'true');
          if (firstContent) {
            firstContent.style.maxHeight = firstContent.scrollHeight + 'px';
            firstContent.setAttribute('aria-hidden', 'false');
            firstContent.classList.add('is-open');
          }
        }
      }
    {% endif %}

    // Set visible class on initial load for the default active panel
    const initialPanel = faqSection.querySelector('.faq-category-panel.is-active');
    if (initialPanel) {
      initialPanel.classList.add('is-visible');
    }
  }

  // Run initialization on ready state or DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaq);
  } else {
    initFaq();
  }

  // Support Shopify section editor dynamic reload events
  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      initFaq();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Custom FAQ Center",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Desktop Max Width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Line Color",
      "default": "#e2e2e2"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active Tab Highlight Color",
      "default": "#121212"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open First Question By Default",
      "default": true
    },
    {
      "type": "range",
      "id": "anim_speed",
      "label": "Accordion Transition Speed",
      "min": 0.1,
      "max": 0.8,
      "step": 0.1,
      "unit": "s",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Spacing Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
