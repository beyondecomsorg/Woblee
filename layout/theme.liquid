    <script>
    (function() {
      function triggerWishlistAnimation(btn) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        btn.classList.add('is-animating');
        setTimeout(() => {
          btn.classList.remove('is-animating');
        }, 500);

        let container = btn.querySelector('.wishlist-particle-container');
        if (!container) {
          container = document.createElement('div');
          container.className = 'wishlist-particle-container';
          btn.appendChild(container);
        } else {
          container.innerHTML = '';
        }

        // Add expanding ring element
        const ring = document.createElement('div');
        ring.className = 'wishlist-ring';
        container.appendChild(ring);

        const particleCount = 12;
        const colors = ['#FF6B9A', '#A855F7', '#60A5FA', '#34D399', '#FBBF24', '#FB7185'];

        for (let i = 0; i < particleCount; i++) {
          const particle = document.createElement('span');
          particle.className = 'wishlist-particle';
          particle.textContent = '♥';
          
          const color = colors[i % colors.length];
          particle.style.color = color;
          
          container.appendChild(particle);
        }

        setTimeout(() => {
          if (container && container.parentNode) {
            container.remove();
          }
        }, 900);
      }

      function observeWishlistButtons() {
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'data-added') {
              const btn = mutation.target;
              const newValue = btn.getAttribute('data-added');
              const oldValue = mutation.oldValue;
              
              if (newValue === 'true' && (oldValue === 'false' || oldValue === null)) {
                triggerWishlistAnimation(btn);
              }
            }
          });
        });

        observer.observe(document.body, {
          attributes: true,
          attributeFilter: ['data-added'],
          subtree: true,
          attributeOldValue: true
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observeWishlistButtons);
      } else {
        observeWishlistButtons();
      }
    })();
    </script>
    <script>
    (function() {
      function injectShadowStyles(el) {
        if (!el || !el.shadowRoot) return;
        if (el.shadowRoot.querySelector('#custom-shadow-style')) return;
        
        const style = document.createElement('style');
        style.id = 'custom-shadow-style';
        
        if (el.tagName.toLowerCase() === 'shopify-account') {
          style.textContent = `
            .account__item-wrapper,
            .account__item-wrapper *,
            .account__item-text,
            .account__item {
              color: #0c4168 !important;
            }
          `;
        } else if (el.tagName.toLowerCase() === 'shopify-login-form') {
          style.textContent = `
            .login-form__marketing-consent-checkbox:checked + .login-form__marketing-consent-visual {
              background-color: #0a3557 !important;
              box-shadow: 0 0 0 calc(var(--font-size-sm) / 2) #0a3557 inset !important;
            }
          `;
        }
        
        el.shadowRoot.appendChild(style);
      }

      const observer = new MutationObserver((mutations) => {
        const elements = document.querySelectorAll('shopify-account, shopify-login-form');
        elements.forEach((el) => {
          if (el.shadowRoot) {
            injectShadowStyles(el);
          } else {
            const checkInterval = setInterval(() => {
              if (el.shadowRoot) {
                clearInterval(checkInterval);
                injectShadowStyles(el);
              }
            }, 50);
            setTimeout(() => clearInterval(checkInterval), 3000);
          }
        });
      });

      observer.observe(document.body, { childList: true, subtree: true });
      document.querySelectorAll('shopify-account, shopify-login-form').forEach(injectShadowStyles);
    })();
    </script>
