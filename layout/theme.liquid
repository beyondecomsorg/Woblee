    <script>
      (function () {
        'use strict';

        const dialog = document.getElementById('size-chart-dialog');
        const dialogImg = document.getElementById('size-chart-dialog-img');
        if (!dialog || !dialogImg) return;

        // ── Open ──
        // Any .variant-option__size-chart-btn anywhere on the page (Product Page OR Quick View)
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('.variant-option__size-chart-btn');
          if (!btn) return;
          e.preventDefault();
          e.stopPropagation();

          // Swap image if needed (different product's size chart)
          const url = btn.dataset.sizeChartUrl || '';
          if (url && dialogImg.src !== url) {
            dialogImg.src = url;
          }

          // showModal() uses the native top-layer — no z-index fights, ever
          if (!dialog.open) {
            dialog.showModal();
          }
        });

        // ── Close via close button ──
        dialog.addEventListener('click', function (e) {
          if (e.target.closest('.size-chart-dialog__close')) {
            dialog.close();
          }
        });

        // ── Close via clicking the ::backdrop ──
        // When the click target is the <dialog> itself (not its inner content), it's on the backdrop
        dialog.addEventListener('click', function (e) {
          if (e.target === dialog) {
            dialog.close();
          }
        });

        // ── ESC key closes dialog ── (native behavior, but double-guard)
        dialog.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') dialog.close();
        });

        // ── Scroll-lock guard ──
        // The theme's dialog.js checks for [open] on native <dialog> elements, so
        // showModal() / close() automatically satisfies the checkScrollLockSafeguard.
        // No manual body.style manipulation needed here.
      })();
    </script>

    <script>
  (function () {
    var container = document.currentScript
      ? document.currentScript.previousElementSibling
      : null;

    // Fallback: grab the last .fabric-info on the page if the above fails
    if (!container || !container.classList.contains('fabric-info')) {
      var all = document.querySelectorAll('.fabric-info');
      container = all[all.length - 1];
    }
    if (!container) return;

    var raw = container.getAttribute('data-fabric-raw') || '';
    // Decode HTML entities from the escaped attribute
    var txt = document.createElement('textarea');
    txt.innerHTML = raw;
    raw = txt.value;

    // Split into blocks on blank lines
    var blocks = raw.split(/\n\s*\n/).map(function (b) { return b.trim(); }).filter(Boolean);

    var html = '';
    blocks.forEach(function (block) {
      var lines = block.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
      if (lines.length === 0) return;
      var heading = lines[0];
      var body = lines.slice(1).join(' ');
      html += '<div class="fabric-block">' +
                '<h4 class="fabric-heading">' + heading + '</h4>' +
                (body ? '<p class="fabric-body">' + body + '</p>' : '') +
              '</div>';
    });

    container.innerHTML = html;
  })();

document.querySelectorAll('.product-meta-modal__body').forEach((body) => {
  body.innerHTML = body.innerHTML.replace(/(<br\s*\/?>\s*){2,}/gi, '<br>\n');
});
</script>


