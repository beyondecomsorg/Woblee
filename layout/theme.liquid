      Lives as a direct <body> child so showModal() top-layer rendering
      always works regardless of the caller's stacking context.
      Image URL is set dynamically from data-size-chart-url on the trigger.
      =====================================================================
    {%- endcomment -%}
    <dialog id="size-chart-dialog" class="size-chart-dialog" aria-label="Size Chart">
      <div class="size-chart-dialog__inner">
        <header class="size-chart-dialog__header">
          <h2 class="size-chart-dialog__title">Size Chart</h2>
          <button class="size-chart-dialog__close" aria-label="Close size chart">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="size-chart-dialog__body">
          <img id="size-chart-dialog-img" class="size-chart-dialog__img" src="" alt="Size Chart" loading="lazy">
        </div>
      </div>
    </dialog>

    <style>
      /* ── Size Chart Dialog ── */
      #size-chart-dialog {
        border: none;
        padding: 0;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
        max-width: min(860px, 94vw);
        width: 100%;
        overflow: hidden;
        /* Native <dialog> handles centering + top-layer automatically */
      }

      #size-chart-dialog::backdrop {
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
      }

      /* Entry animation: scale up from 95% */
      @keyframes size-chart-in {
        from { opacity: 0; transform: scale(0.94); }
        to   { opacity: 1; transform: scale(1); }
      }
      #size-chart-dialog[open] {
        animation: size-chart-in 0.22s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      }

      .size-chart-dialog__inner {
        display: flex;
        flex-direction: column;
      }

      .size-chart-dialog__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 24px;
        border-bottom: 1px solid #ebebeb;
      }

      .size-chart-dialog__title {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 1px;
      }

      .size-chart-dialog__close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: none;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        transition: background 0.15s, transform 0.2s;
        flex-shrink: 0;
      }
      .size-chart-dialog__close:hover {
        background: #f4f4f4;
        transform: rotate(90deg);
      }

      .size-chart-dialog__body {
        padding: 24px;
        overflow-y: auto;
        max-height: calc(90vh - 80px);
        -webkit-overflow-scrolling: touch;
      }

      .size-chart-dialog__img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
      }

