{% liquid
  assign is_two_col = false
  assign slot_offset = 0
  assign parent_norm = parent_link.title | strip | downcase

  if parent_norm == 'men'
    assign is_two_col = true
    assign slot_offset = 0
  elsif parent_norm == 'women'
    assign is_two_col = true
    assign slot_offset = 4
  elsif parent_norm == 'kids'
    assign is_two_col = true
    assign slot_offset = 8
  else
    assign mega_triggers_raw = block.settings.menu_mega_title | strip | downcase
    if mega_triggers_raw != blank
      assign mega_triggers = mega_triggers_raw | split: ','
      for trigger in mega_triggers
        assign trigger_clean = trigger | strip
        if parent_norm == trigger_clean
          assign is_two_col = true
          assign slot_offset = forloop.index0 | times: 4
          break
        endif
      endfor
    endif
  endif
%}

{% if is_two_col %}
  {% liquid
    assign s1 = slot_offset | plus: 1
    assign s2 = slot_offset | plus: 2
    assign s3 = slot_offset | plus: 3
    assign s4 = slot_offset | plus: 4

    assign img_1 = blank
    assign lbl_1 = blank
    assign lnk_1 = blank
    assign img_2 = blank
    assign lbl_2 = blank
    assign lnk_2 = blank
    assign img_3 = blank
    assign lbl_3 = blank
    assign lnk_3 = blank
    assign img_4 = blank
    assign lbl_4 = blank
    assign lnk_4 = blank

    if s1 == 1
      assign img_1 = block.settings.menu_image_1
      assign lbl_1 = block.settings.menu_title_1
      assign lnk_1 = block.settings.menu_image_1_link
    elsif s1 == 5
      assign img_1 = block.settings.menu_image_5
      assign lbl_1 = block.settings.menu_title_5
      assign lnk_1 = block.settings.menu_image_5_link
    elsif s1 == 9
      assign img_1 = block.settings.menu_image_9
      assign lbl_1 = block.settings.menu_title_9
      assign lnk_1 = block.settings.menu_image_9_link
    endif

    if s2 == 2
      assign img_2 = block.settings.menu_image_2
      assign lbl_2 = block.settings.menu_title_2
      assign lnk_2 = block.settings.menu_image_2_link
    elsif s2 == 6
      assign img_2 = block.settings.menu_image_6
      assign lbl_2 = block.settings.menu_title_6
      assign lnk_2 = block.settings.menu_image_6_link
    elsif s2 == 10
      assign img_2 = block.settings.menu_image_10
      assign lbl_2 = block.settings.menu_title_10
      assign lnk_2 = block.settings.menu_image_10_link
    endif

    if s3 == 3
      assign img_3 = block.settings.menu_image_3
      assign lbl_3 = block.settings.menu_title_3
      assign lnk_3 = block.settings.menu_image_3_link
    elsif s3 == 7
      assign img_3 = block.settings.menu_image_7
      assign lbl_3 = block.settings.menu_title_7
      assign lnk_3 = block.settings.menu_image_7_link
    elsif s3 == 11
      assign img_3 = block.settings.menu_image_11
      assign lbl_3 = block.settings.menu_title_11
      assign lnk_3 = block.settings.menu_image_11_link
    endif

    if s4 == 4
      assign img_4 = block.settings.menu_image_4
      assign lbl_4 = block.settings.menu_title_4
      assign lnk_4 = block.settings.menu_image_4_link
    elsif s4 == 8
      assign img_4 = block.settings.menu_image_8
      assign lbl_4 = block.settings.menu_title_8
      assign lnk_4 = block.settings.menu_image_8_link
    elsif s4 == 12
      assign img_4 = block.settings.menu_image_12
      assign lbl_4 = block.settings.menu_title_12
      assign lnk_4 = block.settings.menu_image_12_link
    endif
  %}

  <div class="mega-menu-split">
    {% if parent_link.links != blank %}
      <div class="mega-menu-split__nav">
        {% for child_link in parent_link.links %}
          <div class="mega-menu-split__nav-item">
            <a href="{{ child_link.url }}" class="mega-menu-split__nav-link">
              {{ child_link.title | downcase | capitalize }}
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="mega-menu-split__images">
      {% for i in (1..4) %}
        {% liquid
          assign card_img = blank
          assign card_lbl = blank
          assign card_lnk = blank
          assign link_index = forloop.index0
          assign fallback_link = parent_link.links[link_index]

          if forloop.index == 1
            assign card_img = img_1
            assign card_lbl = lbl_1
            assign card_lnk = lnk_1 | default: fallback_link.url
          elsif forloop.index == 2
            assign card_img = img_2
            assign card_lbl = lbl_2
            assign card_lnk = lnk_2 | default: fallback_link.url
          elsif forloop.index == 3
            assign card_img = img_3
            assign card_lbl = lbl_3
            assign card_lnk = lnk_3 | default: fallback_link.url
          elsif forloop.index == 4
            assign card_img = img_4
            assign card_lbl = lbl_4
            assign card_lnk = lnk_4 | default: fallback_link.url
          endif

          if card_img == blank and fallback_link.object != blank
            assign card_img = fallback_link.object.featured_image | default: fallback_link.object.image
          endif

          if card_img == blank and card_lbl == blank
            assign card_lbl = fallback_link.title
          endif
        %}

        {% if card_lbl != blank or card_img != blank %}
          <a href="{{ card_lnk | default: '#' }}" class="mega-menu-split__card">
            <div class="mega-menu-split__img-wrap">
              {% if card_img != blank %}
                <img
                  src="{{ card_img | image_url: width: 600 }}"
                  alt="{{ card_lbl | escape }}"
                  class="mega-menu-split__img"
                  loading="lazy"
                  width="600"
                >
              {% else %}
                <div class="mega-menu-split__placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              {% endif %}
            </div>
            {% if card_lbl != blank %}
              <span class="mega-menu-split__label">{{ card_lbl | downcase | capitalize }}</span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

<style>
