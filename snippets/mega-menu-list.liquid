{% if title_1 != blank and parent_title_normalized == title_1 %}
  {% assign custom_menu_image = settings.menu_image_1 %}
{% elsif title_2 != blank and parent_title_normalized == title_2 %}
  {% assign custom_menu_image = settings.menu_image_2 %}
