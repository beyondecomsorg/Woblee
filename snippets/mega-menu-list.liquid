{% elsif title_7 != blank and parent_title_normalized == title_7 %}
  {% assign custom_menu_image = settings.menu_image_7 %}
{% elsif title_8 != blank and parent_title_normalized == title_8 %}
  {% assign custom_menu_image = settings.menu_image_8 %}
{% elsif title_9 != blank and parent_title_normalized == title_9 %}
  {% assign custom_menu_image = settings.menu_image_9 %}
{% elsif title_10 != blank and parent_title_normalized == title_10 %}
  {% assign custom_menu_image = settings.menu_image_10 %}
{% elsif title_11 != blank and parent_title_normalized == title_11 %}
  {% assign custom_menu_image = settings.menu_image_11 %}
{% elsif title_12 != blank and parent_title_normalized == title_12 %}
  {% assign custom_menu_image = settings.menu_image_12 %}
{% endif %}

{% if custom_menu_image != blank %}
  <div class="mega-menu__custom-image-wrap">
    <img
      src="{{ custom_menu_image | image_url: width: 600 }}"
      alt="{{ parent_link.title | escape }}"
      class="mega-menu__custom-image"
      loading="lazy"
    >

    {% if settings.menu_image_2 != blank %}
      <img
        src="{{ settings.menu_image_2 | image_url: width: 600 }}"
        alt="{{ parent_link.title | escape }}"
        class="mega-menu__custom-image"
        loading="lazy"
      >
    {% endif %}

  </div>
{% endif %}

<style>
.mega-menu__custom-image-wrap {
  width: 100%;
  max-width: 380px;
}

.mega-menu__custom-image-wrap{
display: flex;
gap: 10px;
}

.mega-menu__custom-image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  border-radius: 0;
}
</style>

</div>
    {% comment %} <span
      class="mega-menu__content"
      style="--menu-content-columns-desktop: {{ max_collection_columns }}; --menu-content-columns-tablet: {{ max_collection_columns_tablet }}; --resource-card-corner-radius: {{ image_border_radius }}px;"
    >
      <ul
        class="mega-menu__content-list mega-menu__content-list--collections list-unstyled"
        style="--menu-content-columns-desktop: {{ max_featured_collections }}; --menu-content-columns-tablet: {{ max_featured_collections_tablet }};"
      >
        {% for handle in collection_handles limit: max_featured_collections %}
          {% if handle == 'all' %}
            {% assign collection_object = collections.all %}
          {% else %}
            {% assign collection_object = collections[handle] %}
          {% endif %}
          <li class="mega-menu__content-list-item{% if forloop.index > max_featured_collections_tablet %} mega-menu__content-list-item--hidden-tablet{% endif %}">
            {% render 'resource-card',
              resource: collection_object,
              resource_type: 'collection',
              style: 'overlay',
              image_aspect_ratio: content_aspect_ratio,
              image_sizes: image_sizes
            %}
          </li>
        {% endfor %}
      </ul>
    </span> {% endcomment %}
{% endcase %}
{% endunless %}