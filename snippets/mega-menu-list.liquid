{% liquid
  assign is_two_col = false
  assign matched_trigger_index = 0
  assign mega_triggers_raw = block.settings.menu_mega_title | strip | downcase
  assign parent_norm = parent_link.title | strip | downcase
  if mega_triggers_raw != blank
    assign mega_triggers = mega_triggers_raw | split: ','
    for trigger in mega_triggers
      assign trigger_clean = trigger | strip
      if parent_norm == trigger_clean
        assign is_two_col = true
        assign matched_trigger_index = forloop.index0
        break
      endif
    endfor
  endif
  assign slots_per_trigger = 4
  assign slot_offset = matched_trigger_index | times: slots_per_trigger
%}

{% if is_two_col %}
<div class="mega-menu-two-col">
  <div class="mega-menu-two-col__nav">
    {% for child_link in parent_link.links %}
    <div class="mega-menu-two-col__nav-item">
      <a
        href="{{ child_link.url }}"
        class="mega-menu-two-col__nav-link{% if forloop.first %} is-active{% endif %}"
        data-mm-target="{{ child_link.title | handleize }}"
      >{{ child_link.title }}</a>
    </div>
    {% endfor %}
  </div>

  <div class="mega-menu-two-col__panels">
    {% for child_link in parent_link.links %}
      {% liquid
        assign panel_img1 = blank
        assign panel_img2 = blank
        assign panel_img1_link = blank
        assign panel_img2_link = blank
        assign slot_num = forloop.index | plus: slot_offset
        if slot_num == 1
          assign panel_img1 = block.settings.menu_image_1
          assign panel_img2 = block.settings.menu_image_1_2
          assign panel_img1_link = block.settings.menu_image_1_link
          assign panel_img2_link = block.settings.menu_image_1_2_link
        elsif slot_num == 2
          assign panel_img1 = block.settings.menu_image_2
          assign panel_img2 = block.settings.menu_image_2_2
          assign panel_img1_link = block.settings.menu_image_2_link
          assign panel_img2_link = block.settings.menu_image_2_2_link
        elsif slot_num == 3
          assign panel_img1 = block.settings.menu_image_3
          assign panel_img2 = block.settings.menu_image_3_2
          assign panel_img1_link = block.settings.menu_image_3_link
          assign panel_img2_link = block.settings.menu_image_3_2_link
        elsif slot_num == 4
          assign panel_img1 = block.settings.menu_image_4
          assign panel_img2 = block.settings.menu_image_4_2
          assign panel_img1_link = block.settings.menu_image_4_link
          assign panel_img2_link = block.settings.menu_image_4_2_link
        elsif slot_num == 5
          assign panel_img1 = block.settings.menu_image_5
          assign panel_img2 = block.settings.menu_image_5_2
          assign panel_img1_link = block.settings.menu_image_5_link
          assign panel_img2_link = block.settings.menu_image_5_2_link
        elsif slot_num == 6
          assign panel_img1 = block.settings.menu_image_6
          assign panel_img2 = block.settings.menu_image_6_2
          assign panel_img1_link = block.settings.menu_image_6_link
          assign panel_img2_link = block.settings.menu_image_6_2_link
        elsif slot_num == 7
          assign panel_img1 = block.settings.menu_image_7
          assign panel_img2 = block.settings.menu_image_7_2
          assign panel_img1_link = block.settings.menu_image_7_link
          assign panel_img2_link = block.settings.menu_image_7_2_link
        elsif slot_num == 8
          assign panel_img1 = block.settings.menu_image_8
          assign panel_img2 = block.settings.menu_image_8_2
          assign panel_img1_link = block.settings.menu_image_8_link
          assign panel_img2_link = block.settings.menu_image_8_2_link
        elsif slot_num == 9
          assign panel_img1 = block.settings.menu_image_9
          assign panel_img2 = block.settings.menu_image_9_2
          assign panel_img1_link = block.settings.menu_image_9_link
          assign panel_img2_link = block.settings.menu_image_9_2_link
        elsif slot_num == 10
          assign panel_img1 = block.settings.menu_image_10
          assign panel_img2 = block.settings.menu_image_10_2
          assign panel_img1_link = block.settings.menu_image_10_link
          assign panel_img2_link = block.settings.menu_image_10_2_link
        elsif slot_num == 11
          assign panel_img1 = block.settings.menu_image_11
          assign panel_img2 = block.settings.menu_image_11_2
          assign panel_img1_link = block.settings.menu_image_11_link
          assign panel_img2_link = block.settings.menu_image_11_2_link
        elsif slot_num == 12
          assign panel_img1 = block.settings.menu_image_12
          assign panel_img2 = block.settings.menu_image_12_2
          assign panel_img1_link = block.settings.menu_image_12_link
          assign panel_img2_link = block.settings.menu_image_12_2_link
        endif
      %}
      <div
        class="mega-menu-two-col__panel{% if forloop.first %} is-active{% endif %}"
        data-mm-panel="{{ child_link.title | handleize }}"
      >
        {% if panel_img1 != blank %}
          {% if panel_img1_link != blank %}<a href="{{ panel_img1_link }}" class="mega-menu-two-col__img-link">{% else %}<span class="mega-menu-two-col__img-link">{% endif %}
            <img src="{{ panel_img1 | image_url: width: 450 }}" alt="{{ child_link.title | escape }}" class="mega-menu-two-col__img" loading="lazy" width="450">
          {% if panel_img1_link != blank %}</a>{% else %}</span>{% endif %}
        {% endif %}
        {% if panel_img2 != blank %}
          {% if panel_img2_link != blank %}<a href="{{ panel_img2_link }}" class="mega-menu-two-col__img-link">{% else %}<span class="mega-menu-two-col__img-link">{% endif %}
            <img src="{{ panel_img2 | image_url: width: 450 }}" alt="{{ child_link.title | escape }}" class="mega-menu-two-col__img" loading="lazy" width="450">
          {% if panel_img2_link != blank %}</a>{% else %}</span>{% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .mega-menu-two-col {
    display: flex;
    align-items: flex-start;
    width: 100%;
    padding: 20px 0;
    gap: 0;
  }
  .mega-menu-two-col__nav {
    display: flex;
    flex-direction: column;
    min-width: 150px;
    max-width: 190px;
    padding-right: 20px;
    border-right: 1px solid rgba(0,0,0,0.12);
    padding-block: 4px;
  }
  .mega-menu-two-col__nav-item { display: block; }
  .mega-menu-two-col__nav-link {
    display: block;
    padding: 10px 14px;
    color: var(--color-foreground, #1a1a1a);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 400;
    border-radius: 4px;
    transition: color 0.15s;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .mega-menu-two-col__nav-link:hover,
  .mega-menu-two-col__nav-link.is-active {
    color: #41be64;
    font-weight: 600;
  }
  .mega-menu-two-col__panels {
    flex: 1;
    padding-left: 28px;
    min-height: 220px;
  }
  .mega-menu-two-col__panel {
    display: none;
    gap: 12px;
  }
  .mega-menu-two-col__panel.is-active {
    display: flex;
  }
  .mega-menu-two-col__img-link {
    display: block;
    flex: 1;
    overflow: hidden;
    border-radius: 6px;
  }
  .mega-menu-two-col__img {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    transition: transform 0.3s ease;
  }
  .mega-menu-two-col__img-link:hover .mega-menu-two-col__img {
    transform: scale(1.03);
  }
</style>

<script>
(function () {
  function initTwoColMenu(container) {
    var navLinks = container.querySelectorAll('.mega-menu-two-col__nav-link');
    var panels   = container.querySelectorAll('.mega-menu-two-col__panel');
    navLinks.forEach(function (link) {
      link.addEventListener('mouseenter', function () {
        var target = this.getAttribute('data-mm-target');
        navLinks.forEach(function (l) { l.classList.remove('is-active'); });
        panels.forEach(function (p)   { p.classList.remove('is-active'); });
        this.classList.add('is-active');
        var panel = container.querySelector('[data-mm-panel="' + target + '"]');
        if (panel) panel.classList.add('is-active');
      });
    });
  }
  function resetTwoColMenu(container) {
    var links  = container.querySelectorAll('.mega-menu-two-col__nav-link');
    var panels = container.querySelectorAll('.mega-menu-two-col__panel');
    links.forEach(function (l)  { l.classList.remove('is-active'); });
    panels.forEach(function (p) { p.classList.remove('is-active'); });
    if (links[0])  links[0].classList.add('is-active');
    if (panels[0]) panels[0].classList.add('is-active');
  }
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.mega-menu-two-col').forEach(initTwoColMenu);
    document.querySelectorAll('.menu-list__list-item').forEach(function (item) {
      item.addEventListener('pointerenter', function () {
        var c = this.querySelector('.mega-menu-two-col');
        if (c) resetTwoColMenu(c);
      });
    });
  });
})();
</script>
{% endif %}

{%- doc -%}
  Renders mega menu list markup and optional featured content.

  @param {object} parent_link - The linklist to render.
  @param {string} id - Unique ID to assign to the `<ul>` element.
  @param {number} [grid_columns_count] - Number of grid columns for the mega menu.
  @param {number} [grid_columns_count_tablet] - Number of grid columns for the mega menu on tablets.
  @param {number} [grid_columns_count_collection_images] - Number of grid columns when `menu_content_type` is 'collection_images'.
  @param {string} [menu_content_type] - Type of content: 'featured_products', 'featured_collections', 'collection_images', or 'text'.
  @param {number} [content_aspect_ratio] - Aspect ratio for content images.
  @param {number} [image_border_radius] - Border radius for content images.
  @param {object} [section] - The section object.
{%- enddoc -%}

{% liquid
  assign open_column_span = false
  assign column_count = 0
  assign links_before_wrap = 10
  assign max_menu_columns = grid_columns_count | default: 6
  assign max_menu_columns_tablet = grid_columns_tablet | default: 4

  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif

  if menu_content_type == 'collection_images'
    assign collection_links = parent_link.links | where: 'type', 'collection_link'
    assign catalog_links = parent_link.links | where: 'type', 'catalog_link'
    assign collection_list_links = parent_link.links | where: 'type', 'collections_link'
    if collection_links.size == 0 and catalog_links.size == 0 and collection_list_links.size == 0
      assign menu_content_type = 'text'
    endif
  endif

  if menu_content_type == 'featured_collections'
    if parent_link.type == 'collection_link'
      assign collection_handles = parent_link.object.handle | append: ','
    elsif parent_link.type == 'catalog_link' or parent_link.type == 'collections_link'
      assign collection_handles = 'all' | append: ','
    endif
    assign collection_links = parent_link.links | where: 'type', 'collection_link'
    for collection_link in collection_links
      assign collection_handles = collection_handles | append: collection_link.object.handle | append: ','
    endfor
  endif

  if menu_content_type == 'featured_products'
    if parent_link.type == 'collection_link'
      assign collection_object = parent_link.object
    elsif parent_link.type == 'catalog_link' or parent_link.type == 'collections_link'
      assign collection_object = collections.all
    else
      assign menu_content_type = 'text'
    endif
  endif
%}

{% unless is_two_col %}
<ul
  data-menu-list-id="{{ id }}"
  class="mega-menu__list list-unstyled"
  style="--menu-image-border-radius: {{ image_border_radius }}px;"
>
  {% for link in parent_link.links %}
    {% liquid
      if forloop.first or open_column_span == false
        assign open_column_span = true

        assign break_after_modulo = link.links.size | modulo: links_before_wrap
        if break_after_modulo == 1
          assign links_before_wrap = links_before_wrap | minus: 1
        endif

        assign break_after_float = links_before_wrap | times: 1.0
        assign column_span = link.links.size | divided_by: break_after_float | ceil | at_least: 1
        assign column_count = column_count | plus: column_span
        assign should_break_columns = true
        assign span_class = ''

        if menu_content_type == 'collection_images'
          assign should_break_columns = false
          if parent_link.links.size <= 4
            assign span_class = 'mega-menu__column--wide-collection-image'
          endif
        else
          assign span_class = 'mega-menu__column--span-' | append: column_span
        endif

        echo '<li class="mega-menu__column ' | append: span_class | append: '">'
      endif
    %}




    {% assign custom_menu_image = blank %}
    {% assign link_title_normalized = link.title | strip | downcase %}

    {% assign title_1 = settings.menu_title_1 | strip | downcase %}
    {% assign title_2 = settings.menu_title_2 | strip | downcase %}
    {% assign title_3 = settings.menu_title_3 | strip | downcase %}
    {% assign title_4 = settings.menu_title_4 | strip | downcase %}
    {% assign title_5 = settings.menu_title_5 | strip | downcase %}
    {% assign title_6 = settings.menu_title_6 | strip | downcase %}
    {% assign title_7 = settings.menu_title_7 | strip | downcase %}
    {% assign title_8 = settings.menu_title_8 | strip | downcase %}
    {% assign title_9 = settings.menu_title_9 | strip | downcase %}
    {% assign title_10 = settings.menu_title_10 | strip | downcase %}
    {% assign title_11 = settings.menu_title_11 | strip | downcase %}
    {% assign title_12 = settings.menu_title_12 | strip | downcase %}

    {% if link_title_normalized == title_1 %}
      {% assign custom_menu_image = settings.menu_image_1 %}
    {% elsif link_title_normalized == title_2 %}
      {% assign custom_menu_image = settings.menu_image_2 %}
    {% elsif link_title_normalized == title_3 %}
      {% assign custom_menu_image = settings.menu_image_3 %}
    {% elsif link_title_normalized == title_4 %}
      {% assign custom_menu_image = settings.menu_image_4 %}
    {% elsif link_title_normalized == title_5 %}
      {% assign custom_menu_image = settings.menu_image_5 %}
    {% elsif link_title_normalized == title_6 %}
      {% assign custom_menu_image = settings.menu_image_6 %}
    {% elsif link_title_normalized == title_7 %}
      {% assign custom_menu_image = settings.menu_image_7 %}
    {% elsif link_title_normalized == title_8 %}
      {% assign custom_menu_image = settings.menu_image_8 %}
    {% elsif link_title_normalized == title_9 %}
      {% assign custom_menu_image = settings.menu_image_9 %}
    {% elsif link_title_normalized == title_10 %}
      {% assign custom_menu_image = settings.menu_image_10 %}
    {% elsif link_title_normalized == title_11 %}
      {% assign custom_menu_image = settings.menu_image_11 %}
    {% elsif link_title_normalized == title_12 %}
      {% assign custom_menu_image = settings.menu_image_12 %}
    {% endif %}

    <div>
      <a
        href="{{ link.url }}"
        class="mega-menu__link images-custom-images {% if link.links != blank %}mega-menu__link--parent{% endif %}"
      >
        {% if custom_menu_image != blank %}
          <img
            src="{{ custom_menu_image | image_url: width: 300 }}"
            alt="{{ link.title | escape }}"
            class="mega-menu__link-image"
            width="180"
            height="180"
            loading="lazy"
          >
        {% elsif menu_content_type == 'collection_images' %}
          {%- capture collection_image_sizes -%}
            {%- if parent_link.links.size <= 4 -%}
              {%- assign columns_per_item = 2 -%}
            {%- else -%}
              {%- assign columns_per_item = 1 -%}
            {%- endif -%}
            {%- render 'util-mega-menu-img-sizes-attr',
              menu_content_type: 'collection_images',
              settings: settings,
              grid_columns: grid_columns_count,
              grid_columns_tablet: grid_columns_count_tablet,
              grid_columns_collection_images: grid_columns_count_collection_images,
              parent_links_size: parent_link.links.size,
              columns_per_item: columns_per_item
            -%}
          {%- endcapture -%}

          {% render 'link-featured-image', link: link, class: 'mega-menu__link-image', sizes: collection_image_sizes %}
        {% endif %}

        <span class="wrap-text">
          {{- link.title -}}
        </span>
      </a>

      {% if link.links != blank %}
        <ul
          class="list-unstyled"
          {% if should_break_columns %}
            style="column-count: {{ column_span }};"
          {% endif %}
        >
          {% for childLink in link.links %}
            {% assign break_after_modulo = forloop.index | modulo: links_before_wrap %}
            <li
              {% if break_after_modulo == 0 and should_break_columns %}
                style="break-after: column;"
              {% endif %}
            >
              <a
                href="{{ childLink.url }}"
                class="mega-menu__link"
              >
                <span class="wrap-text">{{- childLink.title -}}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {% liquid
      assign next_linklist = parent_link.links[forloop.index]

      if forloop.last
        assign open_column_span = false
      elsif menu_content_type == 'collection_images'
        assign open_column_span = false
      elsif next_linklist.links != blank
        assign open_column_span = false
      elsif link.links != blank and next_linklist.links == blank
        assign open_column_span = false
      endif

      if open_column_span == false
        echo '</li>'
      endif
    %}
  {% endfor %}

</ul>
{% endunless %}



{% unless is_two_col %}
{% liquid
  assign min_products = 2
  assign max_products = 3
  assign min_products_tablet = 1
  assign max_products_tablet = 3
  assign min_collections = 1

  if menu_content_type == 'featured_products'
    assign temp_column_count = column_count | plus: min_products

    if temp_column_count > max_menu_columns
      assign max_product_columns = 2
    else
      assign max_product_columns = max_menu_columns | minus: column_count | at_most: max_products
    endif

    if eager_loading
      assign max_product_columns = max_product_columns | at_most: collection_object.products_count
    else
      assign max_product_columns = 0
    endif

    assign max_featured_products = max_product_columns
    assign max_menu_columns = max_menu_columns | minus: max_product_columns

    assign temp_column_count = column_count | plus: min_products_tablet

    if temp_column_count > max_menu_columns_tablet
      assign max_product_columns_tablet = 1
    else
      assign max_product_columns_tablet = max_menu_columns_tablet | minus: column_count | at_most: max_products_tablet
    endif

    assign max_product_columns_tablet = max_product_columns_tablet | at_most: max_product_columns

    assign max_featured_products_tablet = max_product_columns_tablet
    assign max_menu_columns_tablet = max_menu_columns_tablet | minus: max_product_columns_tablet
  endif

  if menu_content_type == 'featured_collections'
    assign min_featured_collection_columns = min_collections | times: 2
    assign temp_column_count = column_count | plus: min_featured_collection_columns

    if temp_column_count > max_menu_columns
      assign max_collection_columns = 2
    else
      assign max_collection_columns = max_menu_columns | minus: column_count
    endif

    assign max_featured_collections = max_collection_columns | divided_by: 2 | floor
    assign max_menu_columns = max_menu_columns | minus: max_collection_columns

    assign max_collection_columns_tablet = 2
    assign max_featured_collections_tablet = 1
    assign max_menu_columns_tablet = max_menu_columns_tablet | minus: max_collection_columns_tablet
  endif
%}

{% style %}
  [data-menu-grid-id="{{ id }}"] {
    {% if menu_content_type == 'collection_images' and parent_link.links.size < 5 %}
      --menu-columns-desktop: {{ grid_columns_count_collection_images }};
      --menu-columns-tablet: {{ grid_columns_count_tablet }};
    {% else %}
      --menu-columns-desktop: {{ grid_columns_count }};
      --menu-columns-tablet: {{ grid_columns_count_tablet }};
    {% endif %}
  }

  [data-menu-list-id="{{ id }}"] {
    {% if menu_content_type == 'collection_images' and parent_link.links.size < 5 %}
      --menu-columns-desktop: {{ grid_columns_count_collection_images }};
      --menu-columns-tablet: {{ max_menu_columns_tablet }};
    {% else %}
      --menu-columns-desktop: {{ max_menu_columns }};
      --menu-columns-tablet: {{ max_menu_columns_tablet }};
    {% endif %}
  }
{% endstyle %}









{% case menu_content_type %}
  {% when 'featured_products' %}
    {%- capture image_sizes -%}
      {%- render 'util-mega-menu-img-sizes-attr',
        menu_content_type: 'featured_products',
        settings: settings,
        grid_columns: grid_columns_count,
        grid_columns_tablet: grid_columns_count_tablet
      -%}
    {%- endcapture -%}

    <span
      class="mega-menu__content"
      style="--menu-content-columns-desktop: {{ max_product_columns }}; --menu-content-columns-tablet: {{ max_product_columns_tablet }}; --resource-card-corner-radius: {{ image_border_radius }}px;"
    >
    
      <ul class="mega-menu__content-list mega-menu__content-list--products list-unstyled">
        {% if eager_loading %}
          {% paginate collection_object.products by max_featured_products %}
            {% for item in collection_object.products %}
              <li class="mega-menu__content-list-item {% if forloop.index > max_featured_products_tablet %} mega-menu__content-list-item--hidden-tablet{% endif %}">
                {% render 'resource-card',
                  resource: item,
                  resource_type: 'product',
                  image_hover: true,
                  image_aspect_ratio: content_aspect_ratio,
                  image_sizes: image_sizes
                %}
              </li>
            {% endfor %}
          {% endpaginate %}
        {% endif %}
      </ul>
    </span>

  {% when 'featured_collections' %}
    {% assign collection_handles = collection_handles | split: ',' | uniq %}
    {%- capture image_sizes -%}
      {%- render 'util-mega-menu-img-sizes-attr',
        menu_content_type: 'featured_collections',
        settings: settings
      -%}
    {%- endcapture -%}

    {% if collection_handles.size == 1 %}
      {% assign max_featured_collections = 1 %}
    {% endif %}
<div class="menu-item-images {{ link.title }} {{ parent_link.title }} {{ childLink.title }}">

