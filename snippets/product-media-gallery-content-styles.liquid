{%- doc -%}
  Product media gallery content styles extracted into a standalone snippet.

  @example
  {% render 'product-media-gallery-content-styles' %}
{%- enddoc -%}

{% stylesheet %}
  media-gallery:where(.media-gallery--grid) .media-gallery__grid {
    display: none;
  }

  media-gallery.media-gallery--grid .media-gallery__grid .product-media-container {
    /* Needed for safari to stretch to full grid height */
    height: 100%;
  }

  media-gallery slideshow-container {
    aspect-ratio: var(--ratio, 3 / 4);
    width: 100%;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--two-column .media-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Display grid view as a carousel on mobile, grid on desktop */
    media-gallery:is(.media-gallery--grid) slideshow-component {
      display: none;
    }

media-gallery:where(.media-gallery--grid) .media-gallery__grid {
  display: flex;
  overflow-x: auto;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE and Edge */
  gap: 1rem;
}
.layout-panel-flex{
      gap: 0px !important;
}
.media-fit-cover :is(img, video, iframe, .deferred-media__poster-image){
  object-fit: contain !important;
}

media-gallery:where(.media-gallery--grid) .media-gallery__grid::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}
    media-gallery.media-gallery--grid .media-gallery__grid .product-media-container{
          flex: 0 0 25%;
          aspect-ratio: 3 / 4 !important;
    }
    media-gallery.media-gallery--grid .media-gallery__grid .product-media {
          aspect-ratio: 3 / 4 !important;
    }
  }

  .product-media-container__zoom-button {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: var(--layer-flat);
    cursor: zoom-in;
    background-color: transparent;

    &:hover {
      background-color: transparent;
    }
  }

  slideshow-slide.product-media-container--tallest {
    content-visibility: visible;
  }

  .product-media__drag-zoom-wrapper {
    aspect-ratio: inherit;
    min-height: inherit;
    min-width: inherit;
    display: inherit;
    flex: inherit;
  }

  .media-gallery__mobile-controls {
    grid-area: auto;
  }

  .product-media-container--zoomable.product-media-container--image {
    cursor: zoom-in;
  }

  /* Hide count / counter below main product image */
  media-gallery .slideshow-controls__counter,
  media-gallery .media-gallery__mobile-controls:has(.slideshow-controls__counter),
  media-gallery slideshow-controls:has(.slideshow-controls__counter),
  media-gallery .slideshow-controls__counter * {
    display: none !important;
  }

  /* Main product image navigation arrows */
  media-gallery slideshow-arrows {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 14px;
    pointer-events: none;
    z-index: var(--layer-heightened, 4);
    mix-blend-mode: normal !important;
  }

  media-gallery slideshow-arrows .slideshow-control {
    pointer-events: auto !important;
    opacity: 1 !important;
    visibility: visible !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 42px !important;
    height: 42px !important;
    min-width: 42px !important;
    min-height: 42px !important;
    border-radius: 50% !important;
    background-color: rgba(255, 255, 255, 0.95) !important;
    color: #111111 !important;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.16) !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    padding: 0 !important;
  }

  media-gallery slideshow-arrows .slideshow-control:hover {
    background-color: #ffffff !important;
    transform: scale(1.08);
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.22) !important;
  }

  media-gallery slideshow-arrows .slideshow-control:active {
    transform: scale(0.95);
  }

  media-gallery slideshow-arrows .slideshow-control svg,
  media-gallery slideshow-arrows .slideshow-control .svg-wrapper {
    width: 20px !important;
    height: 20px !important;
    color: #111111 !important;
    display: block;
  }

  @media screen and (max-width: 749px) {
    media-gallery slideshow-arrows {
      padding: 0 10px;
    }

    media-gallery slideshow-arrows .slideshow-control {
      width: 40px !important;
      height: 40px !important;
      min-width: 40px !important;
      min-height: 40px !important;
    }

    media-gallery slideshow-arrows .slideshow-control svg,
    media-gallery slideshow-arrows .slideshow-control .svg-wrapper {
      width: 18px !important;
      height: 18px !important;
    }
  }
{% endstylesheet %}
