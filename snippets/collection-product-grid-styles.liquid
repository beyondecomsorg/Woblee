{%- doc -%}
  Applies the collection product-card and grid styles to the given results section.

  @param {object} section - Collection or search results section.
  @param {boolean} [collection_page] - Retain the existing collection-wide selectors on collection pages.
{%- enddoc -%}

{%- liquid
  assign page_scope = 'body.template-collection'
  assign card_scope = page_scope
  assign grid_prefix = ''
  unless collection_page
    assign page_scope = 'body.template-search'
    assign card_scope = page_scope | append: ' .search-results-grid'
    assign grid_prefix = card_scope | append: ' '
  endunless
-%}

{% style %}
  {{ grid_prefix }}.product-grid__item,
  results-list[section-id='{{ section.id }}'] .product-grid__item {
    min-width: 0 !important;
    max-width: 100% !important;
    overflow: hidden;
    box-sizing: border-box !important;
  }

  results-list[section-id='{{ section.id }}'] product-card,
  results-list[section-id='{{ section.id }}'] .product-card__content,
  results-list[section-id='{{ section.id }}'] .product-grid__card,
  results-list[section-id='{{ section.id }}'] .group-block,
  results-list[section-id='{{ section.id }}'] .group-block-content {
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  results-list[section-id='{{ section.id }}'] .group-block,
  results-list[section-id='{{ section.id }}'] .group-block-content,
  results-list[section-id='{{ section.id }}'] .group-block.group-block--height-fit.group-block--width-fill.border-style.spacing-style.size-style,
  {{ card_scope }} .group-block.group-block--height-fit.group-block--width-fill.border-style.spacing-style.size-style,
  {{ card_scope }} .product-card .group-block,
  {{ card_scope }} .product-card .group-block-content {
    padding-inline: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-inline-start: 0 !important;
    padding-inline-end: 0 !important;
    margin-left: 0 !important;
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
  }

  /* Remove all padding from collection product cards & set 5px gap between image and title */
  results-list[section-id='{{ section.id }}'] .product-card,
  results-list[section-id='{{ section.id }}'] .product-card__content,
  results-list[section-id='{{ section.id }}'] .product-grid__card,
  {{ card_scope }} .product-card,
  {{ card_scope }} .product-card__content,
  {{ card_scope }} .product-grid__card,
  {{ grid_prefix }}:is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile) [product-grid-view='default'] .product-grid__card,
  {{ grid_prefix }}:is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile) [product-grid-view='mobile-single'] .product-grid__card {
    padding: 0 !important;
    padding-block: 0 !important;
    padding-inline: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-block-start: 0 !important;
    padding-block-end: 0 !important;
    padding-inline-start: 0 !important;
    padding-inline-end: 0 !important;
    --padding-block-start: 0px !important;
    --padding-block-end: 0px !important;
    --padding-inline-start: 0px !important;
    --padding-inline-end: 0px !important;
    row-gap: 5px !important;
    --product-card-gap: 5px !important;
  }

  results-list[section-id='{{ section.id }}'] [product-grid-view='default'],
  {{ card_scope }} [product-grid-view='default'] {
    --padding-block-start: 0px !important;
    --padding-block-end: 0px !important;
    --padding-inline-start: 0px !important;
    --padding-inline-end: 0px !important;
  }

  {{ grid_prefix }}:is(.collection-wrapper--full-width) .card-gallery,
  {{ grid_prefix }}:is(.collection-wrapper--full-width-on-mobile) .card-gallery,
  results-list[section-id='{{ section.id }}'] .card-gallery,
  results-list[section-id='{{ section.id }}'] .product-media-container,
  results-list[section-id='{{ section.id }}'] .product-media,
  results-list[section-id='{{ section.id }}'] slideshow-component,
  results-list[section-id='{{ section.id }}'] slideshow-slides,
  results-list[section-id='{{ section.id }}'] slideshow-slide,
  {{ card_scope }} .product-card .card-gallery,
  {{ card_scope }} .product-card .product-media-container {
    width: 100% !important;
    aspect-ratio: 4 / 5 !important;
    overflow: hidden !important;
    margin: 0 !important;
    margin-inline-start: 0 !important;
    margin-inline-end: 0 !important;
    margin-bottom: 0 !important;
    padding: 0 !important;
    padding-bottom: 0 !important;
  }

  results-list[section-id='{{ section.id }}'] .card-gallery img,
  results-list[section-id='{{ section.id }}'] .product-media-container img,
  results-list[section-id='{{ section.id }}'] .product-media img,
  results-list[section-id='{{ section.id }}'] picture img,
  {{ card_scope }} .product-card .card-gallery img,
  {{ card_scope }} .product-card .product-media-container img {
    object-fit: cover !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    aspect-ratio: 4 / 5 !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  results-list[section-id='{{ section.id }}'] a[ref="productTitleLink"],
  results-list[section-id='{{ section.id }}'] a.contents.user-select-text,
  results-list[section-id='{{ section.id }}'] .text-block,
  results-list[section-id='{{ section.id }}'] a[ref="productTitleLink"] p,
  results-list[section-id='{{ section.id }}'] a.contents.user-select-text p,
  {{ card_scope }} .product-card a[ref="productTitleLink"] p {
    margin: 0 !important;
    padding: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
  }

  results-list[section-id='{{ section.id }}'] product-price,
  {{ card_scope }} .product-card product-price {
    margin: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding: 0 !important;
  }

  results-list[section-id='{{ section.id }}'] .product-grid,
  results-list[section-id='{{ section.id }}'] ul.product-grid,
  {{ page_scope }} results-list[section-id='{{ section.id }}'] .product-grid,
  {{ card_scope }} .product-grid {
    column-gap: 5px !important;
    --product-grid-gap: {{ section.settings.columns_gap_vertical }}px 5px !important;
    --product-grid-gap-mobile: {{ section.settings.columns_gap_vertical | at_most: 12 }}px 5px !important;
    --product-grid-gap-desktop: {{ section.settings.columns_gap_vertical }}px 5px !important;
  }

  @media screen and (max-width: 768px) {
    results-list[section-id='{{ section.id }}'] .product-grid,
    results-list[section-id='{{ section.id }}'] ul.product-grid,
    {{ page_scope }} results-list[section-id='{{ section.id }}'] .product-grid,
    {{ card_scope }} .product-grid {
      column-gap: 5px !important;
      --product-grid-gap: {{ section.settings.columns_gap_vertical | at_most: 12 }}px 5px !important;
      --product-grid-gap-mobile: {{ section.settings.columns_gap_vertical | at_most: 12 }}px 5px !important;
    }
  }

  results-list[section-id='{{ section.id }}'] a[ref="productTitleLink"],
  results-list[section-id='{{ section.id }}'] a.contents.user-select-text,
  results-list[section-id='{{ section.id }}'] .text-block {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    align-self: stretch !important;
  }

  results-list[section-id='{{ section.id }}'] a.contents.user-select-text p,
  results-list[section-id='{{ section.id }}'] a[ref="productTitleLink"] p,
  results-list[section-id='{{ section.id }}'] .text-block :is(h1, h2, h3, h4, h5, h6, p) {
    font-size: {{ section.settings.collection_card_title_font_size_desktop | default: 15 }}px;
    font-weight: {{ section.settings.collection_card_title_font_weight | default: 700 }};
    line-height: 1.35 !important;
    display: -webkit-box !important;
    -webkit-box-orient: vertical !important;
    -webkit-line-clamp: 2 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    word-break: break-word !important;
    overflow-wrap: break-word !important;
    white-space: normal !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    align-self: stretch !important;
  }

  {{ page_scope }} results-list[section-id='{{ section.id }}'] product-price .price {
    font-size: {{ section.settings.collection_card_price_font_size_desktop | default: 14 }}px;
    font-weight: {{ section.settings.collection_card_price_font_weight | default: 700 }};
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    results-list[section-id='{{ section.id }}'] .product-card,
    results-list[section-id='{{ section.id }}'] .product-card__content,
    results-list[section-id='{{ section.id }}'] .product-grid__card,
    {{ card_scope }} .product-card,
    {{ card_scope }} .product-card__content,
    {{ card_scope }} .product-grid__card,
    {{ grid_prefix }}:is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile) [product-grid-view='default'] .product-grid__card,
    {{ grid_prefix }}:is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile) [product-grid-view='mobile-single'] .product-grid__card {
      padding: 0 !important;
      padding-block: 0 !important;
      padding-inline: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      padding-block-start: 0 !important;
      padding-block-end: 0 !important;
      padding-inline-start: 0 !important;
      padding-inline-end: 0 !important;
      --padding-block-start: 0px !important;
      --padding-block-end: 0px !important;
      --padding-inline-start: 0px !important;
      --padding-inline-end: 0px !important;
      row-gap: 5px !important;
      --product-card-gap: 5px !important;
    }

    {{ grid_prefix }}:is(.collection-wrapper--full-width) .card-gallery,
    {{ grid_prefix }}:is(.collection-wrapper--full-width-on-mobile) .card-gallery,
    results-list[section-id='{{ section.id }}'] .card-gallery,
    {{ card_scope }} .product-card .card-gallery {
      margin-inline-start: 0 !important;
      margin-inline-end: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    results-list[section-id='{{ section.id }}'] .group-block,
    results-list[section-id='{{ section.id }}'] .group-block-content,
    {{ card_scope }} .product-card .group-block,
    {{ card_scope }} .product-card .group-block-content {
      padding: 0 !important;
      padding-block: 0 !important;
      padding-inline: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      margin: 0 !important;
      margin-top: 0 !important;
      padding-top: 0 !important;
      margin-block-start: 0 !important;
      padding-block-start: 0 !important;
    }

    results-list[section-id='{{ section.id }}'] a.contents.user-select-text p,
    results-list[section-id='{{ section.id }}'] a[ref="productTitleLink"] p,
    results-list[section-id='{{ section.id }}'] .text-block :is(h1, h2, h3, h4, h5, h6, p) {
      font-size: {{ section.settings.collection_card_title_font_size_mobile | default: 15 }}px;
      line-height: 1.35 !important;
      min-height: 2.7em;
      max-height: 2.7em;
      align-self: stretch !important;
      margin: 0 !important;
      padding: 0 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      margin-block-start: 0 !important;
      padding-block-start: 0 !important;
    }

    results-list[section-id='{{ section.id }}'] product-price,
    {{ card_scope }} .product-card product-price {
      margin: 0 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding: 0 !important;
    }

    {{ page_scope }} results-list[section-id='{{ section.id }}'] product-price .price {
      font-size: {{ section.settings.collection_card_price_font_size_mobile | default: 14 }}px;
    }

    {{ card_scope }} .product-card .price__sale {
      flex-wrap: nowrap !important;
      gap: 3px !important;
      align-items: baseline !important;
      white-space: nowrap !important;
    }

    {{ card_scope }} .product-card .price__sale .price,
    {{ card_scope }} .product-card .price__sale .price-item--sale {
      font-size: clamp(9.5px, 2.75vw, 12px) !important;
    }

    {{ card_scope }} .product-card .compare-at-price,
    {{ card_scope }} .product-card .price-item--regular {
      font-size: clamp(8.5px, 2.4vw, 10.5px) !important;
      margin-right: 0 !important;
    }

    {{ card_scope }} .product-card .price-item__discount {
      font-size: clamp(8.5px, 2.4vw, 10.5px) !important;
      letter-spacing: 0 !important;
    }
  }

  {{ card_scope }} .product-card .compare-at-price,
  {{ card_scope }} .product-card .price-item--regular {
    color: #718096 !important;
    font-weight: 400 !important;
    font-size: 13px !important;
    text-decoration: line-through !important;
    text-decoration-color: #94a3b8 !important;
    text-decoration-thickness: 1px !important;
  }

  {{ card_scope }} .product-card .price-item--sale,
  {{ card_scope }} .product-card .price__regular .price {
    color: #111111 !important;
    font-weight: 700 !important;
  }

  {{ card_scope }} .product-card .price-item__discount {
    color: #15803d !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: 0.3px !important;
    white-space: nowrap !important;
  }

  {% unless collection_page %}
    {{ card_scope }} .product-card__content .layout-panel-flex {
      gap: 0 !important;
      margin-top: 0 !important;
    }

    {{ card_scope }} .product-card__content .price__sale {
      flex-wrap: wrap;
    }

    @media screen and (max-width: 749px) {
      {{ card_scope }} .product-card__content .price__sale {
        flex-wrap: nowrap !important;
      }
    }
  {% endunless %}
{% endstyle %}
