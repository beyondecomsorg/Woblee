{% comment %}
  PDP Sales Demand Banner Block
  Displays recent sales velocity in theme brand colors with zero border-radius:
  "🔥 196 sales in the last 3 hours – High demand – Selling fast >"
  Hides automatically for sold-out products/variants.
{% endcomment %}

{% liquid
  assign target_product = product | default: closest.product
  assign current_variant = target_product.selected_or_first_available_variant
  assign is_available = target_product.available
  if current_variant != blank and current_variant.available == false
    assign is_available = false
  endif

  if target_product.available == false
    break
  endif

  assign product_id = target_product.id | default: section.id | default: 'main'
  assign sales_count = block.settings.sales_count | default: 196
  assign hours_count = block.settings.hours_count | default: 3
  assign subtext = block.settings.subtext 
%}

<div
  class="pdp-sales-banner pdp-urgency-block"
  {{ block.shopify_attributes }}
  data-product-id="{{ product_id }}"
  {% unless is_available %}style="display: none;"{% endunless %}
>
  <div class="pdp-sales-banner__card">
    <div class="pdp-sales-banner__content">
      <span class="pdp-sales-banner__icon" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C10.5 4.5 9 7.5 10 10.5C8.5 9 7.5 7 7.5 5C5 7.5 4 11 4 14C4 18.4183 7.58172 22 12 22C16.4183 22 20 18.4183 20 14C20 9 16 5 12 2Z"/>
        </svg>
      </span>
      <span class="pdp-sales-banner__text">
        <strong class="pdp-sales-banner__highlight">
          <span id="PdpSalesCount-{{ product_id }}">{{ sales_count }}</span> sold in the last <span id="PdpSalesHours-{{ product_id }}">{{ hours_count }}</span> hours
        </strong>
        {% comment %} <span class="pdp-sales-banner__subtext"> – {{ subtext }}</span> {% endcomment %}
      </span>
    </div>
    <span class="pdp-sales-banner__arrow" aria-hidden="true">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </span>
  </div>
</div>

{% style %}
  .pdp-sales-banner {
    width: 100%;
    margin-top: 6px;
    margin-bottom: 6px;
  }

  .pdp-sales-banner__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background-color: var(--color-background-secondary, #F4F6F8);
    border: 1px solid var(--color-border, #CBD5E1);
    border-radius: 0 !important;
    gap: 10px;
    box-sizing: border-box;
    color: var(--color-foreground, #0C4168);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .pdp-sales-banner__card:hover {
    border-color: var(--color-foreground, #0C4168);
  }

  .pdp-sales-banner__content {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: 1;
    min-width: 0;
  }

  .pdp-sales-banner__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-foreground, #0C4168);
  }

  .pdp-sales-banner__text {
    font-family: var(--font-body--family, sans-serif);
    font-size: 13.5px;
    color: var(--color-foreground, #0C4168);
    line-height: 1.35;
    letter-spacing: 0.1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdp-sales-banner__highlight {
    font-weight: 700;
    color: var(--color-foreground, #0C4168);
  }

  .pdp-sales-banner__subtext {
    color: rgba(12, 65, 104, 0.7);
    font-weight: 400;
  }

  .pdp-sales-banner__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-foreground, #0C4168);
    opacity: 0.65;
    transition: transform 0.2s ease;
  }

  .pdp-sales-banner__card:hover .pdp-sales-banner__arrow {
    transform: translateX(2px);
  }

  @media screen and (max-width: 600px) {
    .pdp-sales-banner__card {
      padding: 9px 12px;
      gap: 8px;
    }
    .pdp-sales-banner__text {
      font-size: 12px;
    }
  }
{% endstyle %}

<script>
  (function() {
    var salesEl = document.getElementById('PdpSalesCount-{{ product_id }}');
    var hoursEl = document.getElementById('PdpSalesHours-{{ product_id }}');
    
    if (salesEl) {
      var randomSales = Math.floor(Math.random() * (228 - 165 + 1)) + 165;
      salesEl.textContent = randomSales;
    }
    
    if (hoursEl) {
      var randomHours = Math.floor(Math.random() * (4 - 2 + 1)) + 2;
      hoursEl.textContent = randomHours;
    }

    // Hide if sold out / unavailable on variant change
    function updateSoldOutState() {
      var banner = document.querySelector('.pdp-sales-banner[data-product-id="{{ product_id }}"]');
      if (!banner) return;
      var form = document.querySelector('form[action*="/cart/add"]');
      var atcBtn = form ? form.querySelector('[type="submit"], [name="add"], .add-to-cart__button, .button--primary') : null;
      var isSoldOut = false;
      if (atcBtn) {
        if (atcBtn.disabled) isSoldOut = true;
        var btnText = (atcBtn.textContent || '').trim().toLowerCase();
        if (btnText.indexOf('sold') !== -1 || btnText.indexOf('soon') !== -1 || btnText.indexOf('out') !== -1 || btnText.indexOf('unavailable') !== -1) {
          isSoldOut = true;
        }
      }
      banner.style.display = isSoldOut ? 'none' : '';
    }

    document.addEventListener('change', updateSoldOutState);
    document.addEventListener('variant:change', updateSoldOutState);
    document.addEventListener('VariantUpdateEvent', updateSoldOutState);
    setTimeout(updateSoldOutState, 150);
  })();
</script>
