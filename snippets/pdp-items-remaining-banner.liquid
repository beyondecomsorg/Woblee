{% comment %}
  PDP Features: Urgency Row (Live Viewers & Stock) + Available Offers Carousel
  Matches Image 2 reference:
  - Row 1: 2 boxes side-by-side (Green eye "43 people viewing this right now" + Green bag "Hurry, only a few still left in stock")
  - Row 2: Available Offers Carousel with green SALE badges and circular arrows
{% endcomment %}

{% liquid
  assign target_product = product | default: closest.product
  assign current_variant = target_product.selected_or_first_available_variant
  assign is_available = target_product.available
  if current_variant != blank and current_variant.available == false
    assign is_available = false
  endif

  if target_product.available == false
    break
  endif

  assign product_id = target_product.id | default: section.id | default: 'main'
  
  # Urgency settings
  assign show_urgency_row = block.settings.enable_urgency_row | default: true
  assign viewer_count = block.settings.viewer_count | default: 43
  assign viewer_text = block.settings.viewer_text | default: 'people viewing this right now'
  
  assign prefix = block.settings.prefix_text | default: 'Hurry,'
  assign highlight = block.settings.highlight_text | default: 'only a few still left in stock'
  if prefix != blank and highlight != blank
    assign stock_text = prefix | append: ' ' | append: highlight
  else
    assign stock_text = prefix | default: highlight | default: 'Hurry, only a few still left in stock'
  endif
%}

<div
  class="pdp-urgency-feature-group"
  {{ block.shopify_attributes }}
  data-product-id="{{ product_id }}"
  {% unless is_available %}style="display: none;"{% endunless %}
>
  {% if show_urgency_row %}
    <div class="pdp-urgency-row">
      <!-- Box 1: Live Viewers -->
      <div class="pdp-urgency-box pdp-urgency-box--viewers">
        <span class="pdp-urgency-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3" fill="#22c55e"></circle>
          </svg>
        </span>
        <span class="pdp-urgency-text">
          <span class="js-pdp-viewer-count" id="PdpViewerCount-{{ product_id }}">{{ viewer_count }}</span> {{ viewer_text }}
        </span>
      </div>

      <!-- Box 2: Stock Urgency -->
      <div class="pdp-urgency-box pdp-urgency-box--stock">
        <span class="pdp-urgency-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 7H19V20C19 20.5523 18.5523 21 18 21H6C5.44772 21 5 20.5523 5 20V7Z" fill="#22c55e"/>
            <path d="M8.5 8.5V5.5C8.5 3.567 10.067 2 12 2C13.933 2 15.5 3.567 15.5 5.5V8.5" stroke="#22c55e" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="pdp-urgency-text">
          {{ stock_text }}
        </span>
      </div>
    </div>
  {% endif %}

  <!-- Offers Carousel -->
  {% render 'available-offers', block: block, section: section, product: target_product %}
</div>

{% style %}
  .pdp-urgency-feature-group {
    width: 100%;
    margin-top: 10px;
    margin-bottom: 8px;
    box-sizing: border-box;
  }

  .pdp-urgency-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    margin-bottom: 10px;
    box-sizing: border-box;
  }

  .pdp-urgency-box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background-color: #F8FAFC !important;
    border: 1px solid #E2E8F0 !important;
    border-radius: 0 !important;
    box-sizing: border-box;
    min-width: 0;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .pdp-urgency-box:hover {
    border-color: #CBD5E1 !important;
  }

  .pdp-urgency-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pdp-urgency-text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    font-size: 12.5px;
    color: #0C4168;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdp-urgency-text strong,
  .pdp-urgency-text .js-pdp-viewer-count {
    font-weight: 500;
    color: #0C4168;
    display: inline-block;
    transition: opacity 0.3s ease;
  }

  @media screen and (max-width: 640px) {
    .pdp-urgency-row {
      gap: 6px;
    }
    .pdp-urgency-box {
      padding: 8px 10px;
      gap: 6px;
    }
    .pdp-urgency-text {
      font-size: 11.5px;
    }
  }

  @media screen and (max-width: 380px) {
    .pdp-urgency-row {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<script>
  (function() {
    var container = document.querySelector('.pdp-urgency-feature-group[data-product-id="{{ product_id }}"]');
    if (!container) return;

    // Hide if sold out / unavailable on variant change
    function updateSoldOutState() {
      var form = document.querySelector('form[action*="/cart/add"]');
      var atcBtn = form ? form.querySelector('[type="submit"], [name="add"], .add-to-cart__button, .button--primary') : null;
      var isSoldOut = false;
      if (atcBtn) {
        if (atcBtn.disabled) isSoldOut = true;
        var btnText = (atcBtn.textContent || '').trim().toLowerCase();
        if (btnText.indexOf('sold') !== -1 || btnText.indexOf('soon') !== -1 || btnText.indexOf('out') !== -1 || btnText.indexOf('unavailable') !== -1) {
          isSoldOut = true;
        }
      }
      var row = container.querySelector('.pdp-urgency-row');
      if (row) {
        row.style.display = isSoldOut ? 'none' : 'grid';
      }
    }

    document.addEventListener('change', updateSoldOutState);
    document.addEventListener('variant:change', updateSoldOutState);
    document.addEventListener('VariantUpdateEvent', updateSoldOutState);
    setTimeout(updateSoldOutState, 150);

    // Live Viewer Count subtle fluctuation
    var countEl = container.querySelector('#PdpViewerCount-{{ product_id }}');
    if (countEl) {
      var baseCount = parseInt(countEl.textContent, 10) || 43;
      var minCount = Math.max(15, baseCount - 5);
      var maxCount = baseCount + 6;

      function fluctuate() {
        var delta = Math.floor(Math.random() * 5) - 2; // -2 to +2
        var current = parseInt(countEl.textContent, 10) || baseCount;
        var next = current + delta;
        if (next < minCount) next = minCount + 1;
        if (next > maxCount) next = maxCount - 1;

        countEl.style.opacity = '0.4';
        setTimeout(function() {
          countEl.textContent = next;
          countEl.style.opacity = '1';
        }, 300);

        var nextDelay = Math.floor(Math.random() * 5000) + 4000;
        setTimeout(fluctuate, nextDelay);
      }
      setTimeout(fluctuate, 4500);
    }
  })();
</script>
