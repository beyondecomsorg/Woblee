{%- doc -%}
  Cart Rewards Milestone Progress Bar
  Redesigned to match the clean UX structure of Reference 2:
  - Header: MAXIMUM DISCOUNT UNLOCKED: 20% OFF + FREE SHIPPING (or dynamic progress message)
  - Milestones: 10% (BUY 1 / +10% OFF) -> 15% (BUY 2 / +15% OFF) -> 20% (BUY 3 / +20% OFF)
  - Horizontal progress line with circular percentage badges
  - Woblee brand primary color (#0C4168)
  - Compact, clean container with no heavy drop shadows
{%- enddoc -%}

{%- liquid
  assign enabled = settings.cart_progress_bar_enable
  if enabled == null
    assign enabled = true
  endif

  assign show_empty = settings.cart_progress_bar_show_empty
  if show_empty == null
    assign show_empty = true
  endif

  if enabled == false
    break
  endif

  if cart.empty? and show_empty == false
    break
  endif

  assign item_count = cart.item_count | default: 0

  assign tier1_label = settings.cart_progress_bar_tier1_label | default: 'BUY 1'
  assign tier1_sublabel = settings.cart_progress_bar_tier1_sublabel | default: '+ 10% OFF'

  assign tier2_label = settings.cart_progress_bar_tier2_label | default: 'BUY 2'
  assign tier2_sublabel = settings.cart_progress_bar_tier2_sublabel | default: '+ 15% OFF'

  assign tier3_label = settings.cart_progress_bar_tier3_label | default: 'BUY 3'
  assign tier3_sublabel = settings.cart_progress_bar_tier3_sublabel | default: '+ 20% OFF'

  assign tier1_unlocked = false
  assign tier2_unlocked = false
  assign tier3_unlocked = false

  if item_count >= 1
    assign tier1_unlocked = true
  endif
  if item_count >= 2
    assign tier2_unlocked = true
  endif
  if item_count >= 3
    assign tier3_unlocked = true
  endif

  # Progress Fill Percentage across the horizontal line
  assign progress_pct = 0
  if item_count == 1
    assign progress_pct = 0
  elsif item_count == 2
    assign progress_pct = 50
  elsif item_count >= 3
    assign progress_pct = 100
  endif
-%}

<cart-progress-bar
  class="cart-progress-bar"
  data-cart-item-count="{{ item_count }}"
  style="--cpb-progress-width: {{ progress_pct }}%;"
>
  <div class="cart-progress-bar__outer-box">
    <div class="cart-progress-bar__inner">
      <!-- Top Motivational Headline -->
      <div class="cart-progress-bar__message" role="status" aria-live="polite">
        <div class="cart-progress-bar__msg-title">
          {% if item_count >= 3 %}
            MAXIMUM DISCOUNT UNLOCKED:
          {% elsif item_count == 2 %}
            BUY 1 MORE PRODUCT TO UNLOCK:
          {% elsif item_count == 1 %}
            BUY 1 MORE PRODUCT TO UNLOCK:
          {% else %}
            ADD 1 PRODUCT TO UNLOCK:
          {% endif %}
        </div>
        <div class="cart-progress-bar__msg-sub">
          {% if item_count >= 3 %}
            20% OFF + FREE SHIPPING
          {% elsif item_count == 2 %}
            20% OFF + FREE SHIPPING
          {% elsif item_count == 1 %}
            15% OFF YOUR ORDER
          {% else %}
            10% OFF YOUR ORDER
          {% endif %}
        </div>
      </div>

      <!-- Progress Track & Milestone Stepper -->
      <div class="cart-progress-bar__stepper-wrap">
        <!-- Background Connecting Line Track -->
        <div class="cart-progress-bar__track-line">
          <!-- Filled Navy Line Track -->
          <div class="cart-progress-bar__fill-line"></div>
        </div>

        <!-- Milestone 1: Buy 1 -> 10% -->
        <div class="cart-progress-bar__milestone milestone-1{% if tier1_unlocked %} is-unlocked{% endif %}">
          <div class="cart-progress-bar__circle">10%</div>
          <span class="cart-progress-bar__label">{{ tier1_label }}</span>
          <span class="cart-progress-bar__target">{{ tier1_sublabel }}</span>
        </div>

        <!-- Milestone 2: Buy 2 -> 15% -->
        <div class="cart-progress-bar__milestone milestone-2{% if tier2_unlocked %} is-unlocked{% endif %}">
          <div class="cart-progress-bar__circle">15%</div>
          <span class="cart-progress-bar__label">{{ tier2_label }}</span>
          <span class="cart-progress-bar__target">{{ tier2_sublabel }}</span>
        </div>

        <!-- Milestone 3: Buy 3 -> 20% -->
        <div class="cart-progress-bar__milestone milestone-3{% if tier3_unlocked %} is-unlocked{% endif %}">
          <div class="cart-progress-bar__circle">20%</div>
          <span class="cart-progress-bar__label">{{ tier3_label }}</span>
          <span class="cart-progress-bar__target">{{ tier3_sublabel }}</span>
        </div>
      </div>
    </div>
  </div>
</cart-progress-bar>

<style>
  .cart-progress-bar {
    display: block;
    width: 100%;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    padding: 6px 6px 8px 6px;
    background: #ffffff;
  }

  .cart-progress-bar * {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
  }

  .cart-progress-bar__outer-box {
    border: 1px solid #e2e8f0;
    border-radius: 0px;
    background: #ffffff;
    padding: 5px;
    box-sizing: border-box;
    width: 100%;
  }

  .cart-progress-bar__inner {
    background-color: ##dddfe0 !important;
    border: none;
    border-radius: 0px;
    padding: 10px 10px 8px 10px;
    box-sizing: border-box;
    width: 100%;
    box-shadow: none;
  }

  /* Top Motivational Headline */
  .cart-progress-bar__message {
    text-align: center;
    line-height: 1.25;
    text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    margin-bottom: 8px;
  }

  .cart-progress-bar__msg-title {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    color: #3f3f40 !important;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 2px;
  }

  .cart-progress-bar__msg-sub {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    color: #0c4168 !important;
    letter-spacing: 0.5px;
    display: block;
  }

  /* Stepper Wrapper */
  .cart-progress-bar__stepper-wrap {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    max-width: 290px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  /* Connecting Track Line */
  .cart-progress-bar__track-line {
    position: absolute;
    top: 14px;
    left: 20px;
    right: 20px;
    height: 2px;
    background-color: #0c4168;
    border-radius: 0px;
    z-index: 1;
  }

  /* Filled Line Track */
  .cart-progress-bar__fill-line {
    height: 100%;
    width: var(--cpb-progress-width, 0%);
    background-color: #0c4168;
    border-radius: 0px;
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Milestone Nodes */
  .cart-progress-bar__milestone {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 62px;
  }

  /* Circular Badge */
  .cart-progress-bar__circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 2px solid #0c4168;
    color: #0c4168;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    font-size: 10px !important;
    font-weight: 700 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    transition: all 0.25s ease;
  }

  /* Unlocked Milestone State */
  .cart-progress-bar__milestone.is-unlocked .cart-progress-bar__circle {
    background-color: #0c4168 !important;
    border-color: #0c4168 !important;
    color: #ffffff !important;
  }

  /* Milestone Labels Under Circles */
  .cart-progress-bar__label {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    color: #0c4168 !important;
    margin-top: 4px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .cart-progress-bar__target {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    font-size: 9px !important;
    font-weight: 600 !important;
    color: #35393e !important;
    margin-top: 1px;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    background: transparent !important;
    padding: 0 !important;
    border: none !important;
  }

  @media screen and (max-width: 400px) {
    .cart-progress-bar {
      padding: 6px 6px 6px 6px;
    }
    .cart-progress-bar__outer-box {
      padding: 4px;
    }
    .cart-progress-bar__inner {
      padding: 9px 8px 7px 8px;
    }
    .cart-progress-bar__milestone {
      width: 58px;
    }
    .cart-progress-bar__circle {
      width: 26px;
      height: 26px;
      font-size: 9.5px;
    }
    .cart-progress-bar__track-line {
      top: 13px;
      left: 20px;
      right: 20px;
    }
  }
</style>

<script>
  if (!customElements.get('cart-progress-bar')) {
    class CartProgressBar extends HTMLElement {
      connectedCallback() {
        this.#bindEvents();
        const initialCount = parseInt(this.dataset.cartItemCount, 10);
        if (!isNaN(initialCount)) {
          this.updateState(initialCount);
        }
      }

      #bindEvents() {
        const events = [
          'cart:update',
          'cart:updated',
          'cart-update',
          'cart:add',
          'cart-add',
          'cart:change',
          'dialog:open',
          'cart-drawer:open',
        ];
        events.forEach((evt) => document.addEventListener(evt, this.#handleCartEvent));
        document.addEventListener('CartUpdateEvent', this.#handleCartEvent);
      }

      #handleCartEvent = (event) => {
        const detail = event?.detail;
        let count = undefined;

        if (detail) {
          if (typeof detail.itemCount === 'number') {
            count = detail.itemCount;
          } else if (typeof detail.item_count === 'number') {
            count = detail.item_count;
          } else if (typeof detail.data?.itemCount === 'number') {
            count = detail.data.itemCount;
          } else if (typeof detail.data?.item_count === 'number') {
            count = detail.data.item_count;
          } else if (typeof detail.cart?.item_count === 'number') {
            count = detail.cart.item_count;
          } else if (typeof detail.resource?.item_count === 'number') {
            count = detail.resource.item_count;
          }
        }

        if (typeof count === 'number') {
          this.updateState(count);
        } else {
          fetch('/cart.js')
            .then((res) => res.json())
            .then((cart) => {
              if (cart && typeof cart.item_count === 'number') {
                this.updateState(cart.item_count);
              }
            })
            .catch(() => {});
        }
      };

      updateState(itemCount) {
        const count = typeof itemCount === 'number' ? itemCount : parseInt(this.dataset.cartItemCount, 10) || 0;
        this.dataset.cartItemCount = count;

        const tier1Unlocked = count >= 1;
        const tier2Unlocked = count >= 2;
        const tier3Unlocked = count >= 3;

        let progressPct = 0;
        if (count === 1) {
          progressPct = 0;
        } else if (count === 2) {
          progressPct = 50;
        } else if (count >= 3) {
          progressPct = 100;
        }
        this.style.setProperty('--cpb-progress-width', `${progressPct}%`);

        const updateMilestone = (selector, isUnlocked) => {
          const m = this.querySelector(selector);
          if (!m) return;
          m.classList.toggle('is-unlocked', isUnlocked);
        };

        updateMilestone('.milestone-1', tier1Unlocked);
        updateMilestone('.milestone-2', tier2Unlocked);
        updateMilestone('.milestone-3', tier3Unlocked);

        let titleText = 'ADD 1 PRODUCT TO UNLOCK:';
        let subText = '10% OFF YOUR ORDER';

        if (count >= 3) {
          titleText = 'MAXIMUM DISCOUNT UNLOCKED:';
          subText = '20% OFF + FREE SHIPPING';
        } else if (count === 2) {
          titleText = 'BUY 1 MORE PRODUCT TO UNLOCK:';
          subText = '20% OFF + FREE SHIPPING';
        } else if (count === 1) {
          titleText = 'BUY 1 MORE PRODUCT TO UNLOCK:';
          subText = '15% OFF YOUR ORDER';
        }

        const titleEl = this.querySelector('.cart-progress-bar__msg-title');
        const subEl = this.querySelector('.cart-progress-bar__msg-sub');
        if (titleEl) titleEl.textContent = titleText;
        if (subEl) subEl.textContent = subText;
      }
    }
    customElements.define('cart-progress-bar', CartProgressBar);
  }
</script>
