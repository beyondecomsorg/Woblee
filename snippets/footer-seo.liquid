          <h5 class="custom-footer__seo-group-title">Top Categories</h5>
          <div class="custom-footer__popular-inline-list">
            {% if section.settings.menu_top_categories != blank and linklists[section.settings.menu_top_categories].links.size > 0 %}
              {% for link in linklists[section.settings.menu_top_categories].links %}
                <a href="{{ link.url }}" class="custom-footer__popular-link custom-footer__popular-inline-link">
                  {{- link.title -}}
                </a>
                {%- unless forloop.last -%}
                  <span class="custom-footer__popular-inline-sep">|</span>
                {%- endunless %}
              {% endfor %}
            {% else %}
              {% for item in top_categories_data %}
                {% assign parts = item | split: '::' %}
                <a href="{{ parts[1] }}" class="custom-footer__popular-link custom-footer__popular-inline-link">
                  {{- parts[0] -}}
                </a>
                {%- unless forloop.last -%}
